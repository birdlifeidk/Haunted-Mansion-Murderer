      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2,
        type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: 'Hello! I''m a Jehovah''s Witness. Would you like to learn about Jesus? '
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2,
        type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: I'm ok...
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2,
        type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: 'Oh, but I should really come in. Jesus fixes everything. '
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2,
        type: 3}
      propertyPath: sentences.Array.data[3].sentence
      value: 'It''s not a good idea. Someone has been killing people lately. It''s
        not good to trust anyone. '
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2,
        type: 3}
      propertyPath: sentences.Array.data[4].sentence
      value: Hey, killing is a sin, and so is lying! I'd never lie! Let's learn about
        Jesus and all his ways!
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2,
        type: 3}
      propertyPath: sentences.Array.data[5].sentence
      value: 'Ok. Fine... '
      objectReference: {fileID: 0}
